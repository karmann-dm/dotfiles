{
  "global": { "show_in_menu_bar": false },
  "profiles": [
    {
      "name": "Default",
      "selected": true,
      "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" },
      "complex_modifications": {
        "parameters": {
          "basic.to_if_alone_timeout_milliseconds": 200,
          "basic.to_if_held_down_threshold_milliseconds": 200
        },
        "rules": [
          {
            "description": "Caps Lock → Escape when tapped, Control when held",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
                "to": [{ "key_code": "left_control", "lazy": true }],
                "to_if_alone": [{ "key_code": "escape" }]
              }
            ]
          },
          {
            "description": "Both shifts together → Caps Lock (in case you ever need it)",
            "manipulators": [
              {
                "type": "basic",
                "from": { "key_code": "left_shift", "modifiers": { "mandatory": ["right_shift"], "optional": ["caps_lock"] } },
                "to": [{ "key_code": "caps_lock" }],
                "to_if_alone": [{ "key_code": "left_shift" }]
              }
            ]
          }
        ]
      }
    }
  ]
}
